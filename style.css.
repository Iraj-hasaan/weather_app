* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #74ebd5, #9face6);
}

.weather-container {
    width: 90%;
    max-width: 450px;
    background: white;
    padding: 35px;
    border-radius: 20px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

h1 {
    margin-bottom: 10px;
    color: #222;
}

.subtitle {
    color: #666;
    margin-bottom: 25px;
}

.search-box {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.search-box input {
    flex: 1;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
}

.search-box button {
    padding: 12px 18px;
    border: none;
    border-radius: 8px;
    background: #2196f3;
    color: white;
    cursor: pointer;
    font-size: 16px;
}

.search-box button:hover {
    background: #1976d2;
}

.weather-result {
    margin-top: 25px;
    display: none;
}

#cityName {
    font-size: 28px;
    margin-bottom: 10px;
}

#weatherIcon {
    font-size: 60px;
    margin: 10px 0;
}

#temperature {
    font-size: 35px;
    margin: 10px 0;
}

#condition {
    font-size: 20px;
    margin-bottom: 10px;
}

#humidity {
    color: #555;
}

#errorMessage {
    color: red;
    margin-top: 10px;
    font-weight: bold;
}

@media (max-width: 500px) {

    .weather-container {
        padding: 25px;
    }

    .search-box {
        flex-direction: column;
    }

    .search-box button {
        width: 100%;
    }
}
